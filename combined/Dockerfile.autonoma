# Combined NetBird server (management + signal + relay + embedded Dex IdP) built
# from source, with its config.yaml rendered from the environment at start.
#
# Differs from Dockerfile.multistage only in the entrypoint: the stock image
# expects a config.yaml to be mounted, which an ephemeral environment cannot
# supply because the public hostname is not known until the container is
# scheduled. Build context is the repository root.
FROM golang:1.25-bookworm AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y gcc libc6-dev git && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w \
    -X github.com/netbirdio/netbird/version.version=$(git describe --tags --always --dirty 2>/dev/null || echo 'dev') \
    -X main.commit=$(git rev-parse --short HEAD 2>/dev/null || echo 'unknown') \
    -X main.builtBy=autonoma" \
    -o netbird-server ./combined

FROM ubuntu:24.04
RUN apt update && apt install -y ca-certificates curl && rm -fr /var/cache/apt

COPY --from=builder /app/netbird-server /go/bin/netbird-server
COPY combined/autonoma-entrypoint.sh /usr/local/bin/autonoma-entrypoint.sh
RUN chmod +x /usr/local/bin/autonoma-entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/autonoma-entrypoint.sh"]
